# Copy this file to .env (same folder as job_watcher.py) and fill in the keys you
# use. Easier: paste them in the app under Settings, Keys and accounts, which keeps
# them in Windows Credential Manager (or the macOS Keychain) instead of this file.
# .env is listed in .gitignore, so your keys are never committed. Never put a key
# in config.toml or companies.csv: those files are shared in git.

# https://serper.dev  (Google results, 2,500 free queries on sign-up)
SERPER_API_KEY=

# https://brave.com/search/api  (only if provider = "brave")
BRAVE_API_KEY=

# https://serpapi.com  (only if provider = "serpapi")
SERPAPI_API_KEY=

# Recruiter emails (outreach.py)
# https://hunter.io  (free plan: 50 credits a month)
HUNTER_API_KEY=

# Only for  python outreach.py --make-drafts  (puts drafts in Gmail with your resume attached).
# Your Gmail address, and an app password from https://myaccount.google.com/apppasswords
# (2-Step Verification must be on). This is not your normal Gmail password.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Claude: fit scores, tailored resumes and email drafts in the app.
# https://console.anthropic.com  (you pay Anthropic per request; Settings sets a monthly cap)
ANTHROPIC_API_KEY=

# Phone alerts through ntfy (https://ntfy.sh). A long, private topic name you also
# subscribe to in the ntfy phone app. Anyone who knows it can read the alerts.
NTFY_TOPIC=
