# Copy this file to .env (same folder as job_watcher.py) and fill in the key
# for the search service named under [search] in config.toml.
# .env is listed in .gitignore, so your keys are never committed.

# https://serper.dev  (Google results, 2,500 free queries on sign-up)
SERPER_API_KEY=

# https://brave.com/search/api  (only if provider = "brave")
BRAVE_API_KEY=

# https://serpapi.com  (only if provider = "serpapi")
SERPAPI_API_KEY=

# Recruiter emails (outreach.py)
# https://hunter.io  (free plan: 50 credits a month)
HUNTER_API_KEY=

# Only for  python outreach.py --make-drafts  (puts drafts in Gmail with your resume attached).
# Your Gmail address, and an app password from https://myaccount.google.com/apppasswords
# (2-Step Verification must be on). This is not your normal Gmail password.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
